#!/bin/sh
set -e

STATE=/var/lib/pve-sensors/applied-args

# Runs the script with the same options as the last install. A failure here
# must not leave the package broken in dpkg: the script already rolls back.
apply() {
    set --
    if [ -f "$STATE" ]; then
        while IFS= read -r a; do [ -n "$a" ] && set -- "$@" "$a"; done < "$STATE"
    fi
    /usr/sbin/pve-sensors "$@" \
        || echo "pve-sensors: could not apply (Proxmox was left as it was). Run 'pve-sensors' to see the error." >&2
}

case "$1" in
    configure)
        # reinstall after 'apt remove': restore the options prerm kept
        if [ -f "$STATE.removed" ]; then
            mv -f "$STATE.removed" "$STATE"
        fi
        modprobe drivetemp 2>/dev/null || true
        sensors-detect --auto >/dev/null 2>&1 || true
        if [ -n "${PVE_SENSORS_NO_APPLY:-}" ]; then
            echo "pve-sensors: PVE_SENSORS_NO_APPLY is set — run 'pve-sensors' to apply."
        elif [ -z "$2" ] || [ -f "$STATE" ]; then
            # fresh install, or upgrade of an install that was applied
            apply
        else
            echo "pve-sensors: the patches are disabled — run 'pve-sensors' to apply."
        fi
        ;;
    triggered)
        if [ -f "$STATE" ]; then
            echo "pve-sensors: pve-manager was updated, re-applying the patches..."
            apply
        fi
        ;;
esac

exit 0
