#!/bin/sh
set -e

# Only on removal: on an upgrade the new version's postinst re-applies.
if [ "$1" = "remove" ]; then
    if [ -f /etc/systemd/system/pve-sensors-collect.service ] \
       || grep -qs PVE-SENSORS /usr/share/perl5/PVE/API2/Nodes.pm /usr/share/pve-manager/js/pvemanagerlib.js; then
        /usr/sbin/pve-sensors --revert || echo "pve-sensors: revert failed; see the restore script in /root/pve-sensors-mod/<date>/" >&2
    fi
fi

exit 0
